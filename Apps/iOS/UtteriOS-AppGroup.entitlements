<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- App Group を使うときだけ Config/Local.xcconfig の UTTER_IOS_CODE_SIGN_ENTITLEMENTS で指定する（#56 の判定待ち。既定では使わない） -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(UTTER_APP_GROUP_ID)</string>
	</array>
</dict>
</plist>
