<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS アプリ（UtterMac）の Entitlement。今ある機能が使うものだけを置く（PERM-01）。
  App Sandbox は使わない（他アプリへの AX 操作のため。docs/ビルド・配布規約.md「署名と識別子」）。
  Release は Hardened Runtime を有効にするため、マイク（録音）を使う PR で
  com.apple.security.device.audio-input を true で追加する。
-->
<plist version="1.0">
<dict>
	<!-- Claude API キーを data protection keychain に保存するため（AC-12）。他アプリとは共有しない -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
