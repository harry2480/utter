// アプリターゲット（Apps/ 以下）の署名と識別子の既定値。
// 個人の Team ID・Bundle ID はここに書かず、同じディレクトリの Local.xcconfig（gitignore 済み）で上書きする
// （docs/ビルド・配布規約.md「署名と識別子」）。雛形は Local.xcconfig.example。
// 既定値は署名なしビルド（scripts/verify.sh・CI）用のダミーで、このままでも署名なしならビルドできる。

// Bundle ID の接頭辞。macOS アプリは <接頭辞>.mac、iOS アプリは <接頭辞>.ios になる
UTTER_BUNDLE_ID_PREFIX = invalid.utter
DEVELOPMENT_TEAM =

// iOS の App Group（#56 の判定待ち）。既定は未設定で、共有結果は iOS アプリの中にだけ保存し、キーボードとは共有しない。
// 使うときは Local.xcconfig で両方を設定する（ID だけでは Entitlement が付かず、アプリ内保存に戻る）
UTTER_APP_GROUP_ID =
UTTER_IOS_CODE_SIGN_ENTITLEMENTS =

// 自動更新（Sparkle 2）の appcast の URL と EdDSA 公開鍵。既定は空で、空なら Sparkle を起動しない（既定無効）。
// Phase 0 #47（依存のライセンス確定）の判定待ちの先行実装。値の与え方は Local.xcconfig.example
UTTER_SPARKLE_FEED_URL =
UTTER_SPARKLE_PUBLIC_ED_KEY =

#include? "Local.xcconfig"
